#!/bin/sh
set -eu
agent=$(git config --worktree --get orchestrator.agent || true)
[ -n "$agent" ] || exit 0
case "$agent" in
  *[!a-z0-9-]* | -*) echo 'invalid agent identity' >&2; exit 1 ;;
esac
# This marker prevents ordinary agent records from becoming collaborator wakes.
# It is attribution for routing, never an authentication credential.
git interpret-trailers --in-place --if-exists replace \
  --trailer "Orchestrator-Agent: $agent" "$1"
